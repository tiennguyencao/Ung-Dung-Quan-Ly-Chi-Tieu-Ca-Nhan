# Optional for local dev — Vite's dev-server proxy (see vite.config.js) already
# forwards /api to the backend on http://localhost:5001, so axiosClient's
# default baseURL of '/api' works with no env file at all.
# Set this when frontend and backend are served from different origins
# (e.g. a production build, or the dev server pointed at a deployed backend).
VITE_API_BASE_URL=http://localhost:5001/api
