NODE_ENV=development
PORT=5001

# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/expense-manager

# Long, random secret used to sign JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never use this placeholder in a deployed environment.
JWT_SECRET=replace-this-with-a-long-random-string

# Frontend origin(s) allowed by CORS, comma-separated when needed.
# The first origin is also used to build password-reset links.
CLIENT_ORIGIN=http://localhost:5173

# Optional for local development. With SMTP unset, a reset link is written
# to the console ONLY when NODE_ENV=development. In test/production the raw
# reset token is never logged; production must configure SMTP to deliver email.
# Set all values below to enable real password-reset email delivery.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
